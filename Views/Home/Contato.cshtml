@{
    ViewData["Title"] = "Contato";
}

<header>
    <nav class="navbar">
            <a asp-controller="Home" asp-action="Index" style="display:flex; align-items:center; gap:10px;">
            <img src="/images/petshoplogo.png" alt="iPet" style="height: 250px;" />
            <span class="logo">i<span>Pet</span></span>
             </a>
        <ul>
            <li><a asp-controller="Home" asp-action="Index">Início</a></li>
            <li><a asp-controller="Produto" asp-action="Produtos">Produtos</a></li>
            <li><a asp-controller="Home" asp-action="Contato">Contato</a></li>
            <li id="navLogin"><a asp-controller="Usuario" asp-action="Login" class="btn-login-nav">Login</a></li>
            <li id="navUsuario" style="display:none;">
                <span id="nomeUsuario" style="color: var(--primary-purple); font-weight: bold;"></span>
                &nbsp;
                <a href="#" onclick="fazerLogout()" class="btn-login-nav">Sair</a>
            </li>
        </ul>
    </nav>
</header>

<div class="contact-container">
    <div class="contact-info">
        <h2>Fale Conosco</h2>
        <p>Tem alguma dúvida ou quer agendar um horário por telefone? Nossa equipe está pronta para atender você e seu pet.</p>
        <div class="info-item">
            <i class="fas fa-phone"></i>
            <div>
                <strong>Telefone:</strong><br>
                (11) 4002-8922
            </div>
        </div>
        <div class="info-item">
            <i class="fab fa-whatsapp"></i>
            <div>
                <strong>WhatsApp:</strong><br>
                (11) 99999-0000
            </div>
        </div>
        <div class="info-item">
            <i class="fas fa-envelope"></i>
            <div>
                <strong>E-mail:</strong><br>
                contato@ipet.com.br
            </div>
        </div>
        <div class="info-item">
            <i class="fas fa-location-dot"></i>
            <div>
                <strong>Endereço:</strong><br>
                Rua das Patas, 123 - Bairro Roxo, São Paulo/SP
            </div>
        </div>
    </div>
</div>

<footer style="text-align: center; padding: 40px; background: var(--off-white); margin-top: 50px;">
    <p>&copy; 2026 iPet - Todos os direitos reservados.</p>
</footer>

@section Scripts {
<script>
var nome = localStorage.getItem("usuarioNome");
if (nome) {
    document.getElementById("navLogin").style.display = "none";
    document.getElementById("navUsuario").style.display = "";
    document.getElementById("nomeUsuario").innerText = "Olá, " + nome + "!";
}

function fazerLogout() {
    localStorage.removeItem("usuarioNome");
    window.location.reload();
}
</script>
}
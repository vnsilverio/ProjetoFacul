@{
    ViewData["Title"] = "Cadastro";
}

<nav class="navbar">
    <a asp-controller="Home" asp-action="Index" class="logo">i<span>Pet</span></a>
    <a asp-controller="Home" asp-action="Index" style="text-decoration: none; color: var(--primary-purple);">
        <i class="fas fa-arrow-left"></i> Voltar
    </a>
</nav>

<div class="auth-container">
    <div class="auth-card">
        <h2>Criar Conta</h2>
        <div class="form-group">
            <label>Nome Completo</label>
            <input type="text" id="cadNome" placeholder="Ex: João Silva" required>
        </div>
        <div class="form-group">
            <label>CPF</label>
            <input type="text" id="cadCpf" placeholder="000.000.000-00" required>
        </div>
        <div class="form-group">
            <label>Endereço</label>
            <input type="text" id="cadEndereco" placeholder="Rua, número, bairro, cidade" required>
        </div>
        <button type="button" class="btn-register" onclick="cadastrar()">Finalizar Cadastro</button>
        <div id="cadMensagem" style="margin-top: 15px; text-align: center;"></div>
        <div style="text-align: center; margin-top: 20px;">
            Já é cliente? <a asp-controller="Usuario" asp-action="Login" style="color: var(--primary-purple); text-decoration: none; font-weight: bold;">Faça Login</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function cadastrar() {
    var nome = document.getElementById("cadNome").value;
    var cpf = document.getElementById("cadCpf").value;
    var endereco = document.getElementById("cadEndereco").value;

    if (!nome || !cpf || !endereco) {
        document.getElementById("cadMensagem").style.color = "red";
        document.getElementById("cadMensagem").innerText = "Por favor, preencha todos os campos.";
        return;
    }

    fetch("/Usuario/Inserir?nome=" + encodeURIComponent(nome) +
          "&cpf=" + encodeURIComponent(cpf) +
          "&endereco=" + encodeURIComponent(endereco))
        .then(r => r.json())
        .then(data => {
            var msg = document.getElementById("cadMensagem");
            if (typeof data === "string" && data.includes("sucesso")) {
                msg.style.color = "green";
                msg.innerText = data;
                setTimeout(() => { window.location.href = "/Usuario/Login"; }, 1500);
            } else {
                msg.style.color = "red";
                msg.innerText = data.mensagem || "Erro ao cadastrar.";
            }
        })
        .catch(err => {
            document.getElementById("cadMensagem").style.color = "red";
            document.getElementById("cadMensagem").innerText = "Erro de conexão: " + err;
        });
}
</script>
}
